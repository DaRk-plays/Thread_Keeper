{
  "name": "threadkeeper-remotion",
  "version": "1.0.0",
  "description": "ThreadKeeper Official Hackathon Demo Video",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts ThreadKeeperHackathonDemo out/video.mp4",
    "still": "remotion still src/index.ts ThreadKeeperHackathonDemo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.4.0"
  }
}
