{
  "name": "thread_keeper",
  "version": "1.0.0",
  "description": "The continuity layer for human attention - Alexa+ hackathon local foundation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && cp -r src/web/public dist/web/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc && node dist/web/server.js",
    "start": "node dist/web/server.js",
    "demo": "tsc && node dist/cli/demo.js",
    "verify:mcp": "tsc && node dist/cli/mcp-client.js",
    "verify:web": "tsc && node dist/cli/verify-web.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaRk-plays/Thread_Keeper.git"
  },
  "keywords": [
    "continuity",
    "alexa-plus",
    "mcp",
    "cognitive-checkpoint"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
